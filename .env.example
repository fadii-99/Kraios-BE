DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=False

POSTGRES_DB=kraios
POSTGRES_USER=kraios_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
AI_PLACEHOLDER_DELAY_SECONDS=5
CELERY_TASK_TIME_LIMIT=1200
CELERY_TASK_SOFT_TIME_LIMIT=1140
PROJECT_UPLOAD_MAX_BYTES=26214400

DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Change to django.core.mail.backends.smtp.EmailBackend to send real emails.
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your-smtp-username
DJANGO_EMAIL_HOST_PASSWORD=replace-with-an-smtp-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=15
KRAIOS_SUPPORT_EMAIL=support@example.com

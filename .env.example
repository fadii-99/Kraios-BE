DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_SSL_REDIRECT=False

# Managed Postgres on AWS (RDS) - not run as a container here.
POSTGRES_DB=kraios
POSTGRES_USER=kraios_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=your-db-instance.xxxxxxxxxx.region.rds.amazonaws.com
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
# Leave AI_PIPELINE_ENABLED unset or False and every generation job returns
# a placeholder image/table instead of calling a provider.
AI_PLACEHOLDER_DELAY_SECONDS=5
AI_PIPELINE_ENABLED=True
CELERY_TASK_TIME_LIMIT=1200
CELERY_TASK_SOFT_TIME_LIMIT=1140
PROJECT_UPLOAD_MAX_BYTES=26214400

DJANGO_DEFAULT_FROM_EMAIL=noreply@example.com
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Change to django.core.mail.backends.smtp.EmailBackend to send real emails.
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=your-smtp-username
DJANGO_EMAIL_HOST_PASSWORD=replace-with-an-smtp-password
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
DJANGO_EMAIL_TIMEOUT=15
KRAIOS_SUPPORT_EMAIL=support@example.com

# AI pipeline. Enable only after required provider keys are configured.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Kraios
OPENROUTER_MODEL_FLOORPLAN=openai/gpt-5.6-sol
OPENROUTER_FLOORPLAN_MAX_TOKENS=16000
OPENROUTER_MODEL_BOQ=anthropic/claude-fable-5
OPENROUTER_GUIDED_RENDER_MODEL=google/gemini-3-pro-image-preview
OPENROUTER_MODEL_ISOMETRIC=openai/gpt-5.4-image-2

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
GEMINI_REQUEST_TIMEOUT=120

# Optional Vertex fallback for 2D/3D generation.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=

# BOQ pricing and document-agent providers.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=construction-materials

# Stable pipeline controls. These preserve the extracted defaults.
MAX_UPLOAD_BYTES=20971520
MAX_IMAGE_DIM=1600
PDF_RENDER_DPI=180
FIDELITY_GATE_ENABLED=True
FIDELITY_MIN_SCORE=75
FIDELITY_MAX_EXTRACTION_ATTEMPTS=2
RENDER_VERIFY_ENABLED=True
RENDER_VERIFY_MODEL=anthropic/claude-haiku-4.5
RENDER_VERIFY_MIN_SCORE=75
